<?xml version="1.0"?>
<phpunit
	bootstrap="tests/phpunit/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	convertDeprecationsToExceptions="false"
>
	<testsuites>
		<testsuite name="SlideCraft">
			<directory prefix="class-" suffix="-test.php">./tests/phpunit/</directory>
		</testsuite>
	</testsuites>
</phpunit>
